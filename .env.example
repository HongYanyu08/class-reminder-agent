# Copy to .env on YOUR machine and fill in. Never commit .env, never paste the key into chat or code.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ---- reminder sending (scripts/run_scheduler.py --tick --send) ----
# Channel: console | outbox | webhook | gateway (default console)
# REMINDER_CHANNEL=outbox
# webhook channel: target URL is a secret — env only, never in files
# REMINDER_WEBHOOK_URL=
# REMINDER_WEBHOOK_TIMEOUT=10
# outbox channel: directory for outbox.jsonl (default <data-dir>/outbox)
# REMINDER_OUTBOX_DIR=
# gateway channel: command template for your OpenClaw install,
# placeholders {text} {task_id} {type} {user_id}
# REMINDER_GATEWAY_CMD=
