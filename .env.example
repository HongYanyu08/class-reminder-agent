# Copy to .env on YOUR machine and fill in. Never commit .env, never paste the key into chat or code.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ---- reminder sending (scripts/run_scheduler.py --tick --send) ----
# Channel: console | outbox | webhook | gateway (default console)
# These variables are the TOP priority source. The Web UI's 发送渠道 page
# stores the same fields in data/sender_settings.json (gitignored, local
# only — see data/sender_settings.example.json); env vars override it.
# REMINDER_CHANNEL=outbox
# webhook channel: target URL is a secret — keep it in env or in the
# gitignored data/sender_settings.json, never in committed files
# REMINDER_WEBHOOK_URL=
# REMINDER_WEBHOOK_TIMEOUT=10
# outbox channel: directory for outbox.jsonl (default <data-dir>/outbox)
# REMINDER_OUTBOX_DIR=
# gateway channel: command template for your OpenClaw install,
# placeholders {text} {task_id} {type} {user_id}
# REMINDER_GATEWAY_CMD=

# ---- weather lead time for departure reminders (src/weather.py) ----
# Open-Meteo forecast, free, no API key. Set BOTH coordinates of the place
# the user departs from; if either is missing/invalid the weather feature
# is simply off (departures keep their base lead time). Coordinates are
# only ever read from here — never stored in data files.
# WEATHER_LAT=
# WEATHER_LON=
# forecast cache TTL in hours (default 3) and request timeout in seconds (default 10)
# WEATHER_CACHE_TTL_H=3
# WEATHER_TIMEOUT=10
