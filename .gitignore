# secrets - never commit
.env
*.key
# sender channel settings written by the Web UI: the webhook URL inside is
# effectively a password — local file only, never committed (the tracked
# template is data/sender_settings.example.json)
data/sender_settings.json

# python
__pycache__/
*.pyc
.pytest_cache/

# generated runtime data (keep the example templates, ignore live copies if you split them)
# data/occurrences.json
# data/reminders.json
data/weather_cache.json
data/speak_trigger_state.json
data/*.bak-*

# OS / editor
.DS_Store
.idea/
.vscode/
